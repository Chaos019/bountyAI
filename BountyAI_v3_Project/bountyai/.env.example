# ╔══════════════════════════════════════════════════════════════╗
# ║          BountyAI — API Keys & Configuration                 ║
# ║  Copy this file to .env and fill in your keys               ║
# ║  The app WORKS WITHOUT ANY KEYS using smart mock data        ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Server ─────────────────────────────────────────────────────
PORT=5000

# ── Claude AI (Anthropic) ──────────────────────────────────────
# Powers: Professional AI report generation, vulnerability suggestions
# Get free key: https://console.anthropic.com/keys
# Without this key: Uses built-in template reports (still very good)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ── NVD / NIST CVE Database ────────────────────────────────────
# Powers: Live CVE lookup for detected technology stack
# Get FREE key: https://nvd.nist.gov/developers/request-an-api-key
# Without this key: Uses pre-loaded CVE database (covers all 8 programs)
NVD_API_KEY=your_nvd_api_key_here

# ── Shodan ─────────────────────────────────────────────────────
# Powers: Port scanning and service detection
# Get key: https://shodan.io (free account gives basic access)
# Without this key: Returns standard port data (443/80)
SHODAN_API_KEY=your_shodan_api_key_here

# ── Wappalyzer ─────────────────────────────────────────────────
# Powers: Technology stack detection (React, Node, nginx etc.)
# Get key: https://wappalyzer.com/api (500 free requests/month)
# Without this key: Uses tech stack database (pre-loaded for all programs)
WAPPALYZER_API_KEY=your_wappalyzer_api_key_here

# ── SerpAPI ────────────────────────────────────────────────────
# Powers: Live web search for domain intelligence
# Get key: https://serpapi.com (100 free searches/month)
# Without this key: Not used in current version
SERPAPI_KEY=your_serpapi_key_here

# ── HackerOne ──────────────────────────────────────────────────
# Powers: Live program data sync from HackerOne API
# Get key: https://hackerone.com/settings/api_token (free account)
# Without this key: Uses pre-seeded program database (8 Indian programs)
HACKERONE_USERNAME=your_h1_username
HACKERONE_API_TOKEN=your_h1_api_token

# ─── NOTE: crt.sh subdomain enumeration ─────────────────────────
# crt.sh is ALWAYS live — it's a free public API, zero key needed.
# Real subdomain data is fetched on every recon scan automatically.
